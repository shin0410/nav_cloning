<launch>
  <group ns="camera_center">
    <node pkg="usb_cam" name="camera0" type="usb_cam_node" output="screen">
      <param name="video_device" value="/dev/video4"/>
      <param name="image_width" value="640"/>
      <param name="image_height" value="480"/>
      <!-- <param name="pixel_format" value="mjpeg"/> -->
      <param name="pixel_format" value="yuyv"/>
      <param name="io_method" value="mmap"/>
      <param name="framerate" value="30"/>
      <param name="camera_frame_id" value="camera_center"/>
      <param name="camera_info_url" value="file:///home/{user_name}/.../camera_center.yaml"/>
      <param name="auto_white_balance" value="false"/>
      <param name="auto_focus" value="false"/>
    </node>
  </group>

  <group ns="camera_left">
    <node pkg="usb_cam" name="camera1" type="usb_cam_node" output="screen">
      <param name="video_device" value="/dev/video6"/>
      <param name="image_width" value="640"/>
      <param name="image_height" value="480"/>
      <!-- <param name="pixel_format" value="mjpeg"/> -->
      <param name="pixel_format" value="yuyv"/>
      <param name="io_method" value="mmap"/>
      <param name="framerate" value="30"/>
      <param name="camera_frame_id" value="camera_left"/>
      <param name="camera_info_url" value="file:///home/{user_name}/.../camera_left.yaml"/>
      <param name="auto_white_balance" value="false"/>
      <param name="auto_focus" value="false"/>
    </node>
  </group>

  <group ns="camera_right">
    <node pkg="usb_cam" name="camera2" type="usb_cam_node" output="screen">
      <param name="video_device" value="/dev/video8"/>
      <param name="image_width" value="640"/>
      <param name="image_height" value="480"/>
      <!-- <param name="pixel_format" value="mjpeg"/> -->
      <param name="pixel_format" value="yuyv"/>
      <param name="io_method" value="mmap"/>
      <param name="framerate" value="30"/>
      <param name="camera_frame_id" value="camera_right"/>
      <param name="camera_info_url" value="file:///home/{user_name}/.../camera_right.yaml"/>
      <param name="auto_white_balance" value="false"/>
      <param name="auto_focus" value="false"/>
    </node>
  </group>
</launch>

