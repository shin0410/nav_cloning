<?xml version="1.0"?>
<launch>
  <arg name="script" default="test.py"/>
  <arg name="nav_cloning_launch_file" default="$(find nav_cloning)/launch/nav_cloning.launch"/>


  <node pkg="timed_roslaunch" type="timed_roslaunch.sh"
        args="5 $(arg nav_cloning_launch_file) script:=$(arg script)"
        name="timed_roslaunch" output="screen" />

</launch>
