<?xml version="1.0"?>
<launch>
  <!-- 引数の定義 -->
  <arg name="script" default="nav_cloning_node_augmix.py"/>
  <arg name="mode" default="use_dl_output"/>
  <arg name="world_name" default="Tsudanuma_2-3.world"/>
  <arg name="map_file" default="cit_3f_map"/> <!-- 拡張子を除去 -->
  <arg name="waypoints_file" default="cit_3f_loop"/> <!-- 拡張子を除去 -->
  <arg name="dist_err" default="0.8"/>
  <arg name="initial_pose_x" default="-5.0"/>
  <arg name="initial_pose_y" default="7.7"/>
  <arg name="initial_pose_a" default="3.14"/>
  <arg name="use_waypoint_nav" default="true"/>
  <arg name="use_initpose" default="false"/>
  <arg name="robot_x" default="-5.0"/>
  <arg name="robot_y" default="7.7"/>
  <arg name="robot_yaw" default="3.14"/>

  <!-- パラメータの設定 -->
  <rosparam param="/nav_cloning_node/mode" subst_value="True">$(arg mode)</rosparam>

  <!-- 必要に応じて初期位置を設定するノード -->
  <group if="$(arg use_initpose)">
    <node pkg="nav_cloning" type="initpose" name="initpose" output="screen"/>
  </group>

  <!-- nav_cloningノードの起動 -->
  <node pkg="timed_roslaunch" type="timed_roslaunch.sh"
        args="5 nav_cloning nav_cloning.launch script:=$(arg script)"
        name="timed_roslaunch_script" output="screen"/>

  <!-- 引数を一行で記述し、拡張子を追加 -->
  <node pkg="timed_roslaunch" type="timed_roslaunch.sh"
        args="5 orne_navigation_executor play_waypoints_nav_gamma.launch map_file:=$(find nav_cloning)/maps/$(arg map_file) waypoints_file:=$(find nav_cloning)/maps/$(arg waypoints_file) dist_err:=$(arg dist_err) initial_pose_x:=$(arg initial_pose_x) initial_pose_y:=$(arg initial_pose_y) initial_pose_a:=$(arg initial_pose_a) use_waypoint_nav:=$(arg use_waypoint_nav)"
        name="timed_roslaunch_waypoint" output="screen"/>

  <!-- ウェイポイントナビゲーションの開始 -->
  <node pkg="timed_roslaunch" type="timed_roslaunch.sh"
        args="20 nav_cloning start_wp_nav.launch"
        name="timed_roslaunch_start_wp" output="screen"/>
</launch>

